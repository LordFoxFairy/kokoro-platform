DATABASE_URL_PAYMENT="mysql://root:kokoro_root@127.0.0.1:3307/kokoro"
KOKORO_PAYMENT_PORT=4241
KOKORO_USER_BASE_URL="http://kokoro-user:4211"
KOKORO_MODEL_BASE_URL="http://kokoro-model:4221"
KOKORO_CREDIT_BASE_URL="http://kokoro-credit:4231"
KOKORO_PAYMENT_BASE_URL="http://kokoro-payment:4241"
KOKORO_PAYMENT_CONFIRM_SWEEP_INTERVAL_SECONDS=300
KOKORO_PAYMENT_CONFIRM_STALE_SECONDS=120
# 启用真实 webhook 验签的渠道（逗号分隔）；留空=只 mock，未列出的渠道命中时恒 501（fail-loud）。
KOKORO_PAYMENT_ENABLED_PROVIDERS=""
# provider 配置里的 webhookSecretRef 指向的 env 变量名示例（值必须是各自渠道的验签密钥/公钥，不入库）。
# stripe=webhook signing secret(HMAC 密钥)；alipay/wechat=对方平台公钥 PEM（用于 RSA2 验签）。
KOKORO_PAYMENT_WEBHOOK_SECRET_MOCK="example-token"
KOKORO_PAYMENT_WEBHOOK_SECRET_STRIPE="whsec_example-token"
KOKORO_PAYMENT_ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nexample\n-----END PUBLIC KEY-----"
KOKORO_PAYMENT_WECHAT_PLATFORM_CERT="-----BEGIN PUBLIC KEY-----\nexample\n-----END PUBLIC KEY-----"

# 内部服务间调用凭据（per-caller）：生产 default-internal fail-fast,须配调用本服务的 caller secret。
# 生成:openssl rand -hex 32。全平台共享同一注册表(各服务只校验访问它的 caller,多配无害)。
KOKORO_INTERNAL_SECRET_SESSION=dev-internal-session-not-real
KOKORO_INTERNAL_SECRET_WEB_BFF=dev-internal-web-bff-not-real
KOKORO_INTERNAL_SECRET_ADMIN=dev-internal-admin-not-real
KOKORO_INTERNAL_SECRET_HUB=dev-internal-hub-not-real
KOKORO_INTERNAL_SECRET_PAYMENT=dev-internal-payment-not-real
KOKORO_INTERNAL_SECRET_CREDIT=dev-internal-credit-not-real
