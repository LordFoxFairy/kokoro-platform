datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_MODEL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model ProviderAccount {
  id            String               @id @default(cuid())
  provider      String
  key           String
  label         String
  secretRef     String
  status        ProviderAccountStatus @default(active)
  priority      Int                  @default(100)
  transportKind ModelTransportKind
  healthStatus  ProviderHealthStatus @default(unknown)
  metadata      Json?
  bindings      ModelBinding[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([provider, key])
  @@index([status, priority])
  @@map("model_provider_accounts")
}

model ModelBinding {
  id                String             @id @default(cuid())
  providerAccountId String
  provider          String
  modelName         String
  displayName       String
  featureKey        String
  labelKeys         Json
  inputModalities   Json
  outputModalities  Json
  transportKind     ModelTransportKind
  gatewayModelName  String?
  contextWindow     Int?
  priority          Int                @default(100)
  status            ModelBindingStatus @default(active)
  metadata          Json?
  providerAccount   ProviderAccount    @relation(fields: [providerAccountId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([providerAccountId, modelName, transportKind])
  @@index([featureKey, status, priority])
  @@index([provider, modelName])
  @@map("model_bindings")
}

model ModelLabel {
  id               String           @id @default(cuid())
  key              String           @unique
  displayName      String
  description      String?
  featureKey       String
  tier             String?
  defaultBindingId String?
  status           ModelLabelStatus @default(active)
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([featureKey, status])
  @@map("model_labels")
}

model SiteModelPolicy {
  id        String                @id @default(cuid())
  siteId    String
  labelKey  String
  status    SiteModelPolicyStatus @default(visible)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([siteId, labelKey])
  @@index([siteId])
  @@map("model_site_policies")
}

enum SiteModelPolicyStatus {
  visible
  hidden
}

enum ProviderAccountStatus {
  active
  disabled
}

enum ProviderHealthStatus {
  unknown
  healthy
  degraded
  down
}

enum ModelBindingStatus {
  active
  disabled
}

enum ModelLabelStatus {
  active
  disabled
}

enum ModelTransportKind {
  litellm
  direct
  internal
}
