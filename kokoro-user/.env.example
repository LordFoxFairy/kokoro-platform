DATABASE_URL_USER="mysql://root:kokoro_root@127.0.0.1:3307/kokoro"
KOKORO_USER_PORT=4211
KOKORO_USER_BASE_URL="http://kokoro-user:4211"
KOKORO_MODEL_BASE_URL="http://kokoro-model:4221"
KOKORO_CREDIT_BASE_URL="http://kokoro-credit:4231"
KOKORO_PAYMENT_BASE_URL="http://kokoro-payment:4241"
# 终端用户会话签发（POST /auth/sessions）。
# 生产正解：RS256 私钥（PEM/PKCS8）。配置即以 RS256 签发，kid=公钥指纹前 16hex，
# 经 GET /.well-known/jwks.json 暴露公钥供 kokoro-session 验签。生产未配私钥 → 启动 fail-fast。
# 生成示例（勿用于生产）：openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# KOKORO_USER_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# 轮换用上一把私钥（可选）：其公钥一并进 JWKS，令旧 kid 在飞 token 平滑过渡。
# KOKORO_USER_JWT_PRIVATE_KEY_PREVIOUS=""
# HS256 共享密钥：仅 dev/test 退化档（生产禁用，未配私钥即 fail-fast）。示例用明显假值。
# 缺省且无私钥（非生产）时 /auth/sessions fail-closed 返回 503。
KOKORO_AUTH_JWT_SECRET="example-shared-hs256-secret"
KOKORO_AUTH_JWT_TTL_SECONDS=3600
KOKORO_AUTH_JWT_ISSUER="kokoro-user"
# 长效 refresh token（POST /auth/refresh 换新 access + 轮换 refresh）。只存哈希，可吊销可轮换。
# TTL 缺省 30 天（下限 1 小时，上限 90 天）。
KOKORO_AUTH_REFRESH_TTL_SECONDS=2592000
# magic-link 登录（POST /auth/magic-links + /consume）。token 只存哈希，TTL 缺省 15 分钟。
KOKORO_AUTH_MAGIC_TTL_SECONDS=900
# V1 dev 投递档：response=一次性 token 直接回响应体（仅限 dev 部署！），log=只写服务日志不回体（缺省）。
# 生产邮件投递（SMTP/供应商）后续接入，此处不配置 SMTP。
KOKORO_AUTH_MAGIC_DELIVERY="log"
# email+ip 两维窗口限频。配 KOKORO_REDIS_URL 即用 Redis 固定窗口（多副本一致，不可达 fail-open 放行+WARN）；
# 未配=进程内存计数（单副本 dev）。RATE_MAX=单邮箱阈值；RATE_IP_MAX=单 IP 阈值（缺省 RATE_MAX*10）。
KOKORO_AUTH_MAGIC_RATE_MAX=5
# KOKORO_AUTH_MAGIC_RATE_IP_MAX=50
KOKORO_AUTH_MAGIC_RATE_WINDOW_SECONDS=900
# KOKORO_REDIS_URL="redis://127.0.0.1:6379"

# 内部服务间调用凭据（per-caller）：生产 default-internal fail-fast,须配调用本服务的 caller secret。
# 生成:openssl rand -hex 32。全平台共享同一注册表(各服务只校验访问它的 caller,多配无害)。
KOKORO_INTERNAL_SECRET_SESSION=dev-internal-session-not-real
KOKORO_INTERNAL_SECRET_WEB_BFF=dev-internal-web-bff-not-real
KOKORO_INTERNAL_SECRET_ADMIN=dev-internal-admin-not-real
KOKORO_INTERNAL_SECRET_HUB=dev-internal-hub-not-real
KOKORO_INTERNAL_SECRET_PAYMENT=dev-internal-payment-not-real
KOKORO_INTERNAL_SECRET_CREDIT=dev-internal-credit-not-real
