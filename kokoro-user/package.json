{
  "name": "@kokoro/user",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx src/interfaces/http/main.ts",
    "start": "tsx src/interfaces/http/main.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "coverage": "vitest run --coverage --no-file-parallelism"
  },
  "dependencies": {
    "@kokoro/platform-kit": "workspace:*",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.6.2",
    "jose": "^5.9.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
