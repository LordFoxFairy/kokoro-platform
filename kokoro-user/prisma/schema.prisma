datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_USER")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model User {
  id              String           @id @default(cuid())
  siteId          String
  externalUserId  String
  email           String?
  displayName     String?
  avatarUrl       String?
  status          UserStatus       @default(active)
  disabledAt      DateTime?
  lastSeenAt      DateTime?
  metadata        Json?
  deletedAt       DateTime?
  deletedBy       String?
  deleteReason    String?
  memberships     Membership[]
  ownedTeams      Team[]           @relation("TeamOwner")
  serviceAccounts ServiceAccount[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([siteId, externalUserId])
  @@index([siteId, status])
  @@index([siteId, status, deletedAt])
  @@index([deletedAt])
  @@map("users")
}

model Team {
  id                  String           @id @default(cuid())
  siteId              String
  name                String
  slug                String?
  type                TeamType
  ownerUserId         String
  personalOwnerUserId String?          @unique
  status              TeamStatus       @default(active)
  disabledAt          DateTime?
  metadata            Json?
  deletedAt           DateTime?
  deletedBy           String?
  deleteReason        String?
  owner               User             @relation("TeamOwner", fields: [ownerUserId], references: [id])
  memberships         Membership[]
  invites             Invite[]
  serviceAccounts     ServiceAccount[]
  roles               Role[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([siteId, slug])
  @@index([ownerUserId])
  @@index([siteId, status])
  @@index([siteId, status, deletedAt])
  @@index([deletedAt])
  @@map("teams")
}

model Membership {
  id           String           @id @default(cuid())
  teamId       String
  userId       String
  role         MembershipRole   @default(member)
  status       MembershipStatus @default(active)
  disabledAt   DateTime?
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  team         Team             @relation(fields: [teamId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([teamId, userId])
  @@index([teamId, status, deletedAt])
  @@index([userId, status, deletedAt])
  @@index([deletedAt])
  @@map("memberships")
}

model Role {
  id           String     @id @default(cuid())
  teamId       String?
  scopeKey     String
  key          String
  name         String
  permissions  Json
  status       RoleStatus @default(active)
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  team         Team?      @relation(fields: [teamId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([scopeKey, key])
  @@index([teamId, status, deletedAt])
  @@index([deletedAt])
  @@map("roles")
}

model Invite {
  id           String         @id @default(cuid())
  teamId       String
  email        String
  role         MembershipRole
  status       InviteStatus   @default(pending)
  tokenHash    String
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  team         Team           @relation(fields: [teamId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([teamId, status, deletedAt])
  @@index([email])
  @@index([deletedAt])
  @@map("invites")
}

model ServiceAccount {
  id           String               @id @default(cuid())
  teamId       String?
  ownerUserId  String?
  name         String
  tokenPrefix  String
  secretHash   String
  status       ServiceAccountStatus @default(active)
  lastUsedAt   DateTime?
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  team         Team?                @relation(fields: [teamId], references: [id])
  ownerUser    User?                @relation(fields: [ownerUserId], references: [id])
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([tokenPrefix])
  @@index([teamId, status, deletedAt])
  @@index([ownerUserId, status, deletedAt])
  @@index([deletedAt])
  @@map("service_accounts")
}

// magic-link 一次性登录链接：只存 token 哈希不存原文；同 (siteId,email) 新链签发时旧未消费链置 supersededAt。
model MagicLink {
  id           String    @id @default(cuid())
  siteId       String
  email        String
  tokenHash    String    @unique
  // 可选设备绑定：签发方（web BFF）设一次性 nonce cookie，把 nonce 哈希随申请交来落库，
  // 消费时必须再次带同哈希才转移。NULL = 未绑定（旧链/无 nonce 的直连调用），保持向后兼容。
  nonceHash    String?
  expiresAt    DateTime
  consumedAt   DateTime?
  supersededAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([siteId, email, consumedAt, supersededAt])
  @@map("magic_links")
}

// 长效 refresh token：只存 token 哈希不存原文；消费=一次性条件转移（防并发/重放），轮换成链，可整族吊销。
model RefreshToken {
  id           String    @id @default(cuid())
  namespace    String    // = team.id（session 的 sub，不透明）
  siteId       String
  tokenHash    String    @unique
  tokenPrefix  String    // 明文前 12 字符，仅审计/查找（非密）
  expiresAt    DateTime
  consumedAt   DateTime? // 轮换：消费即置（一次性）
  revokedAt    DateTime? // 吊销
  replacedById String?   // 轮换链：被哪个新 token 取代（重放检测用）
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([namespace, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actorService String?
  teamId       String?
  action       String
  targetType   String
  targetId     String
  metadata     Json?
  requestId    String?
  createdAt    DateTime @default(now())

  @@index([teamId, createdAt])
  @@index([targetType, targetId])
  @@map("user_audit_logs")
}

enum UserStatus {
  active
  disabled
}

enum TeamType {
  personal
  team
}

enum TeamStatus {
  active
  disabled
}

enum MembershipRole {
  owner
  admin
  member
}

enum MembershipStatus {
  active
  disabled
}

enum RoleStatus {
  active
  disabled
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

enum ServiceAccountStatus {
  active
  disabled
}
