DATABASE_URL_CREDIT="mysql://root:kokoro_root@127.0.0.1:3307/kokoro"
KOKORO_CREDIT_PORT=4231
KOKORO_USER_BASE_URL="http://kokoro-user:4211"
KOKORO_MODEL_BASE_URL="http://kokoro-model:4221"
KOKORO_CREDIT_BASE_URL="http://kokoro-credit:4231"
KOKORO_PAYMENT_BASE_URL="http://kokoro-payment:4241"

# 用量计费面（run hold/settle）：token 计价 unit + hold 预估用量 + 冻结冗余系数。
KOKORO_CREDIT_USAGE_INPUT_UNIT="input_token"
KOKORO_CREDIT_USAGE_OUTPUT_UNIT="output_token"
KOKORO_CREDIT_HOLD_EST_INPUT_TOKENS=1000
KOKORO_CREDIT_HOLD_EST_OUTPUT_TOKENS=1000
KOKORO_CREDIT_HOLD_BUFFER_PERCENT=20

# 冻结过期回收：hold TTL（落 expiresAt）+ 进程内 sweeper 周期（秒）。兜底调用方崩溃后的悬挂冻结。
KOKORO_CREDIT_HOLD_TTL_SECONDS=86400
KOKORO_CREDIT_HOLD_SWEEP_INTERVAL_SECONDS=300
