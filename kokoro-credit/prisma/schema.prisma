datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_CREDIT")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model CreditAccount {
  id            String              @id @default(cuid())
  siteId        String
  ownerKind     CreditOwnerKind
  ownerId       String
  status        CreditAccountStatus @default(active)
  // 三桶（按过期节奏，L3.1）：balanceMicros=永久桶（积分包/欢迎，不过期）。
  // 以下为时间型桶，懒刷新（access 时按水位重置，use-or-lose，非 cron）；allowance 由生效 Plan 供给（L3.2 前恒 0）。
  balanceMicros BigInt              @default(0)
  heldMicros    BigInt              @default(0)
  dailyMicros   BigInt              @default(0)
  dailyResetOn  DateTime?
  periodMicros  BigInt              @default(0)
  periodResetOn DateTime?
  // 时间桶当期额度（懒刷新的重置目标 + release/refund 归还的夹紧上限）。L3.2 由生效 Plan 填；现恒 0。
  dailyAllowanceMicros  BigInt      @default(0)
  periodAllowanceMicros BigInt      @default(0)
  // 组织级消费上限（周期上限微单位）+ 周期口径；null=不限。admin 面设置。
  quotaMicros   BigInt?
  quotaPeriod   CreditQuotaPeriod?
  metadata      Json?
  deletedAt     DateTime?
  deletedBy     String?
  deleteReason  String?
  holds         CreditHold[]
  ledgerEntries CreditLedgerEntry[]
  usageRecords  UsageRecord[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([siteId, ownerKind, ownerId])
  @@index([siteId, status])
  @@index([siteId, status, deletedAt])
  @@index([deletedAt])
  @@map("credit_accounts")
}

model CreditLedgerEntry {
  id                 String        @id @default(cuid())
  accountId          String
  amountMicros       BigInt
  balanceAfterMicros BigInt
  reason             CreditReason
  idempotencyKey     String        @unique
  requestId          String?
  metadata           Json?
  account            CreditAccount @relation(fields: [accountId], references: [id])
  createdAt          DateTime      @default(now())

  @@index([accountId, createdAt])
  @@map("credit_ledger_entries")
}

model CreditHold {
  id             String           @id @default(cuid())
  accountId      String
  amountMicros   BigInt
  // B1 三桶预留明细：hold 时从各桶按序（过期先扣）扣走的量，三者之和=amountMicros。
  // settle/release 据此把未用差额按夹紧规则归还各桶；无此明细则无法知道该退回哪个桶。
  reservedDailyMicros     BigInt @default(0)
  reservedPeriodMicros    BigInt @default(0)
  reservedPermanentMicros BigInt @default(0)
  status         CreditHoldStatus @default(active)
  idempotencyKey String           @unique
  expiresAt      DateTime?
  // 用量结算面(usage settle)在冻结时落 pricing_ref 与归属，settle 仅凭 holdId + usage 即可复算实额。
  featureKey     String?
  labelKey       String?
  modelBindingId String?
  requestId      String?
  account        CreditAccount    @relation(fields: [accountId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([accountId, status])
  // 过期回收 sweep 的驱动查询：status='active' AND expiresAt < now。
  @@index([status, expiresAt])
  @@map("credit_holds")
}

model UsageRecord {
  id             String            @id @default(cuid())
  accountId      String?
  featureKey     String
  amountMicros   BigInt
  modelBindingId String?
  requestId      String?
  idempotencyKey String?           @unique
  status         UsageRecordStatus @default(recorded)
  metadata       Json?
  account        CreditAccount?    @relation(fields: [accountId], references: [id])
  createdAt      DateTime          @default(now())

  @@index([featureKey, createdAt])
  @@index([accountId, createdAt])
  @@map("credit_usage_records")
}

model PricingRule {
  id             String            @id @default(cuid())
  featureKey     String
  labelKey       String?
  unit           String
  amountMicros   BigInt
  status         PricingRuleStatus @default(active)
  effectiveFrom  DateTime          @default(now())
  effectiveUntil DateTime?
  metadata       Json?
  deletedAt      DateTime?
  deletedBy      String?
  deleteReason   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([featureKey, status])
  @@index([featureKey, status, deletedAt])
  @@index([deletedAt])
  @@map("credit_pricing_rules")
}

enum CreditOwnerKind {
  user
  team
}

enum CreditQuotaPeriod {
  monthly
}

enum CreditAccountStatus {
  active
  disabled
}

enum CreditReason {
  manual_adjustment
  subscription
  model_call
  tool_call
  refund
  welcome
}

enum CreditHoldStatus {
  active
  captured
  released
  expired
}

enum UsageRecordStatus {
  recorded
  settled
  failed
}

enum PricingRuleStatus {
  active
  disabled
}
