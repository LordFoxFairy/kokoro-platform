datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_ADMIN")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

model OperatorRole {
  key         String            @id
  name        String
  permissions Json
  operators   OperatorAccount[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("operator_roles")
}

model OperatorAccount {
  id          String         @id @default(cuid())
  email       String         @unique
  displayName String
  roleKey     String
  scopeSites  Json
  status      OperatorStatus @default(active)
  role        OperatorRole   @relation(fields: [roleKey], references: [key])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([roleKey])
  @@map("operator_accounts")
}

model AuditLog {
  id              String      @id @default(cuid())
  actorOperatorId String?
  actorEmail      String?
  moduleId        String
  resourceId      String
  actionId        String
  targetRoute     String
  siteId          String?
  reason          String?
  result          AuditResult
  statusCode      Int
  requestId       String
  createdAt       DateTime    @default(now())

  @@index([createdAt])
  @@index([siteId, createdAt])
  @@map("audit_logs")
}

model ApprovalRequest {
  id                 String         @id @default(cuid())
  status             ApprovalStatus @default(pending)
  moduleId           String
  resourceId         String
  actionId           String
  params             Json?
  body               Json?
  siteId             String?
  reason             String?
  requiredPermission String
  executionKey       String
  requestedById      String
  requestedByEmail   String
  decidedById        String?
  decidedByEmail     String?
  decisionNote       String?
  resultStatusCode   Int?
  error              String?
  requestedAt        DateTime       @default(now())
  decidedAt          DateTime?
  executedAt         DateTime?

  @@index([status, requestedAt])
  @@index([siteId])
  @@map("approval_requests")
}

enum ApprovalStatus {
  pending
  approved
  rejected
  executed
  failed
}

enum OperatorStatus {
  active
  disabled
}

enum AuditResult {
  ok
  error
}
