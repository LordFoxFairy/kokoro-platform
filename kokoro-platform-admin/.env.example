KOKORO_ADMIN_PORT=4290

# 运营台自有持久化（OperatorAccount/Role/AuditLog）。本地覆盖 mysql://root:kokoro_root@127.0.0.1:3307/kokoro_admin
DATABASE_URL_ADMIN=mysql://kokoro:kokoro@kokoro-mysql:3306/kokoro_admin

# 默认稳定服务名（docker compose / k8s 内部 DNS）。
# 本地直接在宿主机跑各服务时，用 127.0.0.1 覆盖：
#   KOKORO_SITE_BASE_URL=http://127.0.0.1:4201 ...
KOKORO_SITE_BASE_URL=http://kokoro-site:4201
KOKORO_USER_BASE_URL=http://kokoro-user:4211
KOKORO_MODEL_BASE_URL=http://kokoro-model:4221
KOKORO_CREDIT_BASE_URL=http://kokoro-credit:4231
KOKORO_PAYMENT_BASE_URL=http://kokoro-payment:4241

# 认证模式：proxy(生产)/oidc/dev。
#  proxy —— BFF 可信头架构：Next.js 运营台(Auth.js magic-link)登录后，middleware 向网关注入
#           x-kokoro-operator + x-kokoro-proxy-secret；网关 timingSafeEqual 校 secret + 读 operator，缺/错→401。
#           Auth.js 不原生签发 JWKS，故不用 oidc 验签，改由共享 secret 建立 BFF↔网关信任。
#  dev   —— 本地直连：沿用 x-kokoro-operator 头，缺省 KOKORO_ADMIN_DEV_OPERATOR。
KOKORO_ADMIN_AUTH_MODE=dev
# 生产：KOKORO_ADMIN_AUTH_MODE=proxy + 下面的 secrets（逗号分隔支持轮换，须与 admin-web KOKORO_ADMIN_PROXY_SECRET 之一一致）
# KOKORO_ADMIN_PROXY_SECRETS=change-me-strong-secret
# KOKORO_ADMIN_DEV_OPERATOR=admin@kokoro.local
# oidc（备用，若未来接标准 IdP）：
# KOKORO_ADMIN_OIDC_JWKS_URL=
# KOKORO_ADMIN_OIDC_ISSUER=
# KOKORO_ADMIN_OIDC_AUDIENCE=kokoro-admin
# KOKORO_ADMIN_OIDC_EMAIL_CLAIM=email
