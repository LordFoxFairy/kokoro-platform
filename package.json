{
  "name": "kokoro-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:hub": "pnpm --filter @kokoro/hub dev",
    "db:generate": "prisma generate",
    "db:migrate": "node dist/src/infrastructure/postgres/migrator.js",
    "db:migrate:platform": "node dist/src/infrastructure/postgres/migrator.js",
    "model-control:import-canonical": "tsx scripts/model-control/import-canonical.mts",
    "model-control:activate-catalog": "tsx scripts/model-control/activate-catalog.mts",
    "model-control:change-site-policy": "tsx scripts/model-control/change-site-policy.mts",
    "model-option:materialize": "tsx scripts/model-control/materialize-options.mts",
    "model-option:publish-site-release": "tsx scripts/model-control/publish-site-release-catalog.mts",
    "admin:bootstrap-authority": "tsx scripts/admin-control/bootstrap-authority.mts",
    "start:api": "node dist/src/process/api.js",
    "start:admission": "node dist/src/process/admission.js",
    "start:admin": "node dist/src/process/admin.js",
    "start:authorization": "node dist/src/process/authorization.js",
    "start:asset-data-plane": "node dist/src/process/asset-data-plane.js",
    "start:model-gateway": "node dist/src/process/model-gateway.js",
    "start:commerce-worker": "node dist/src/process/commerce-worker.js",
    "start:site-worker": "node dist/src/process/site-worker.js",
    "start:asset-worker": "node dist/src/process/asset-worker.js",
    "start:admin-worker": "node dist/src/process/admin-worker.js",
    "start:identity-worker": "node dist/src/process/identity-worker.js",
    "start:authorization-maintenance": "node dist/src/process/authorization-maintenance.js",
    "test:repository": "node --test test/repository/*.test.mjs",
    "test:platform": "vitest run test/*.test.ts test/architecture/*.test.ts",
    "test:platform-api-runtime": "vitest run test/unit/platform-api-runtime-contract.test.ts test/unit/secret-files.test.ts",
    "test:admin-control": "vitest run test/unit/admin-*.test.ts test/unit/outbox.test.ts",
    "test:identity": "vitest run test/unit/identity-*.test.ts test/unit/platform-worker-identity.test.ts test/unit/secret-files.test.ts",
    "test:security": "vitest run test/security/*.test.ts",
    "test:component:postgres": "vitest run test/component/postgres-foundation.test.ts --no-file-parallelism",
    "test:component:credit-media-child-concurrency": "vitest run test/component/postgres-foundation.test.ts --no-file-parallelism -t 'serializes Media child authority'",
    "test": "pnpm run test:repository && pnpm run test:platform && pnpm run test:platform-api-runtime && pnpm run test:admin-control && pnpm run test:identity && pnpm run test:security && pnpm -r test",
    "test:integration": "pnpm --filter @kokoro/hub test:integration",
    "build:runtime": "pnpm run db:generate && tsc -p tsconfig.runtime.json && pnpm -r --if-present build:runtime",
    "typecheck:platform": "tsc -p tsconfig.json --noEmit",
    "typecheck": "pnpm run typecheck:platform && pnpm -r typecheck",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@bufbuild/protobuf": "2.13.0",
    "@bufbuild/protovalidate": "1.2.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@hpke/core": "1.9.0",
    "@kokoro/hub": "workspace:*",
    "@kokoro/platform-kit": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "jose": "6.2.4",
    "openid-client": "6.8.4",
    "otplib": "13.4.1",
    "pg": "8.22.0",
    "prisma": "7.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.15.6",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^2.1.9",
    "yaml": "^2.9.0"
  }
}
