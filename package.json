{
  "name": "kokoro-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:db": "docker compose up -d mysql",
    "dev:site": "pnpm --filter @kokoro/site dev",
    "dev:user": "pnpm --filter @kokoro/user dev",
    "dev:model": "pnpm --filter @kokoro/model dev",
    "dev:credit": "pnpm --filter @kokoro/credit dev",
    "dev:payment": "pnpm --filter @kokoro/payment dev",
    "db:generate": "prisma generate && pnpm -r db:generate",
    "db:migrate": "pnpm -r db:migrate",
    "db:migrate:platform": "node dist/src/infrastructure/postgres/migrator.js",
    "db:reset": "pnpm -r db:reset",
    "model-control:export-legacy": "tsx scripts/model-control/export-legacy.mts",
    "model-control:import-bundle": "tsx scripts/model-control/import-bundle.mts",
    "model-control:import-canonical": "tsx scripts/model-control/import-canonical.mts",
    "model-control:activate-catalog": "tsx scripts/model-control/activate-catalog.mts",
    "model-control:change-site-policy": "tsx scripts/model-control/change-site-policy.mts",
    "model-option:materialize-legacy": "tsx scripts/model-control/materialize-legacy-options.mts",
    "model-option:publish-site-release": "tsx scripts/model-control/publish-site-release-catalog.mts",
    "admin:bootstrap-authority": "tsx scripts/admin-control/bootstrap-authority.mts",
    "start:api": "node dist/src/process/api.js",
    "start:admin": "node dist/src/process/admin.js",
    "start:authorization": "node dist/src/process/authorization.js",
    "start:worker": "node dist/src/process/worker.js",
    "test:repository": "node --test test/repository/*.test.mjs",
    "test:platform": "vitest run test/*.test.ts test/architecture/*.test.ts",
    "test:admin-control": "vitest run test/unit/admin-*.test.ts test/unit/outbox.test.ts",
    "test:component:postgres": "vitest run test/component/postgres-foundation.test.ts --no-file-parallelism",
    "test": "pnpm run test:repository && pnpm run test:platform && pnpm run test:admin-control && pnpm -r test",
    "test:integration": "pnpm -r test:integration",
    "build:runtime": "pnpm run db:generate && tsc -p tsconfig.runtime.json && pnpm -r --if-present build:runtime",
    "typecheck:platform": "tsc -p tsconfig.json --noEmit",
    "typecheck": "pnpm run typecheck:platform && pnpm -r typecheck",
    "lint": "eslint .",
    "test:integration:dev": "node scripts/integration-dev.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@bufbuild/protobuf": "2.13.0",
    "@bufbuild/protovalidate": "1.2.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@hpke/core": "1.9.0",
    "@kokoro/credit": "workspace:*",
    "@kokoro/hub": "workspace:*",
    "@kokoro/payment": "workspace:*",
    "@kokoro/platform-kit": "workspace:*",
    "@kokoro/site": "workspace:*",
    "@kokoro/user": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "jose": "6.2.4",
    "otplib": "13.4.1",
    "pg": "8.22.0",
    "prisma": "7.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.15.6",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.39.1",
    "mysql2": "3.15.3",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^2.1.9",
    "yaml": "^2.9.0"
  }
}
