{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kokoro.dev/product-surface-catalog/v1",
  "title": "Kokoro Product Surface Catalog Revision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schemaRevision", "catalogRevisionRef", "revision", "state", "products", "surfaces", "canonicalJourneys", "operationFamilyRefs", "publishedAt"],
  "properties": {
    "contract": {"const": "kokoro.product-surface-catalog.v1"},
    "schemaRevision": {"const": "1"},
    "catalogRevisionRef": {"$ref": "#/$defs/ref"},
    "revision": {"$ref": "#/$defs/decimal"},
    "state": {"enum": ["draft", "validating", "published", "retired"]},
    "products": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/product"}},
    "surfaces": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/surface"}},
    "canonicalJourneys": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/journey"}},
    "operationFamilyRefs": {"$ref": "#/$defs/refSet"},
    "publishedAt": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
  },
  "allOf": [
    {"if": {"properties": {"state": {"enum": ["published", "retired"]}}}, "then": {"properties": {"publishedAt": {"$ref": "#/$defs/timestamp"}}}},
    {"if": {"properties": {"state": {"enum": ["draft", "validating"]}}}, "then": {"properties": {"publishedAt": {"type": "null"}}}}
  ],
  "$defs": {
    "ref": {"type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"},
    "decimal": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)$", "maxLength": 39},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"},
    "refSet": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "product": {
      "type": "object", "additionalProperties": false,
      "required": ["productRef", "revision", "surfaceRefs", "requiredProductRefs", "canonicalJourneyRefs", "operationFamilyRefs"],
      "properties": {
        "productRef": {"$ref": "#/$defs/ref"}, "revision": {"$ref": "#/$defs/decimal"},
        "surfaceRefs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "requiredProductRefs": {"$ref": "#/$defs/refSet"}, "canonicalJourneyRefs": {"$ref": "#/$defs/refSet"},
        "operationFamilyRefs": {"$ref": "#/$defs/refSet"}
      }
    },
    "surface": {
      "type": "object", "additionalProperties": false,
      "required": ["surfaceRef", "productRef", "revision", "scopeClass", "requiredSurfaceRefs", "canonicalJourneyRefs", "operationFamilyRefs", "requiredModelRoleRefs"],
      "properties": {
        "surfaceRef": {"$ref": "#/$defs/ref"}, "productRef": {"$ref": "#/$defs/ref"}, "revision": {"$ref": "#/$defs/decimal"}, "scopeClass": {"enum": ["core-always", "profile-selectable"]},
        "requiredSurfaceRefs": {"$ref": "#/$defs/refSet"}, "canonicalJourneyRefs": {"$ref": "#/$defs/refSet"},
        "operationFamilyRefs": {"$ref": "#/$defs/refSet"}, "requiredModelRoleRefs": {"$ref": "#/$defs/refSet"}
      }
    },
    "journey": {
      "type": "object", "additionalProperties": false,
      "required": ["journeyRef", "revision", "entrySurfaceRef", "requiredSurfaceRefs", "requiredJourneyRefs", "operationFamilyRefs"],
      "properties": {
        "journeyRef": {"$ref": "#/$defs/ref"}, "revision": {"$ref": "#/$defs/decimal"}, "entrySurfaceRef": {"$ref": "#/$defs/ref"},
        "requiredSurfaceRefs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "requiredJourneyRefs": {"$ref": "#/$defs/refSet"},
        "operationFamilyRefs": {"$ref": "#/$defs/refSet"}
      }
    }
  }
}
