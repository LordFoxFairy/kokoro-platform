{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kokoro.dev/site-release-candidate/v1",
  "title": "Kokoro Site Release Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schemaRevision",
    "candidateRef",
    "revision",
    "state",
    "siteRef",
    "environment",
    "candidateAuthorizationEpoch",
    "launchProductProfile",
    "productSurfaceCatalog",
    "businessBindings",
    "modelRequirements",
    "createdAt"
  ],
  "properties": {
    "contract": {
      "const": "kokoro.site-release-candidate.v1"
    },
    "schemaRevision": {
      "const": "1"
    },
    "candidateRef": {
      "$ref": "#/$defs/ref"
    },
    "revision": {
      "$ref": "#/$defs/decimal"
    },
    "state": {
      "const": "authorized"
    },
    "siteRef": {
      "$ref": "#/$defs/ref"
    },
    "environment": {
      "enum": [
        "development",
        "preview",
        "staging",
        "production"
      ]
    },
    "candidateAuthorizationEpoch": {
      "$ref": "#/$defs/decimal"
    },
    "launchProductProfile": {
      "$ref": "#/$defs/revisionBinding"
    },
    "productSurfaceCatalog": {
      "$ref": "#/$defs/revisionBinding"
    },
    "businessBindings": {
      "$ref": "#/$defs/businessBindings"
    },
    "modelRequirements": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/modelRequirement"
      }
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)+$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$",
      "maxLength": 39
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 39
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "ownerRevisionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "revision",
        "digest"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "revision": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "ownerRevisionBindingSet": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ownerRevisionBinding"
      }
    },
    "authIdentityClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityIssuer",
        "authenticationPolicy",
        "authorizationPolicy",
        "closureDigest"
      ],
      "properties": {
        "identityIssuer": {
          "$ref": "#/$defs/ownerRevisionBinding"
        },
        "authenticationPolicy": {
          "$ref": "#/$defs/ownerRevisionBinding"
        },
        "authorizationPolicy": {
          "$ref": "#/$defs/ownerRevisionBinding"
        },
        "closureDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "commerceClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offerRevisions",
        "offerPriceRevisions",
        "entitlementTemplateRevisions",
        "creditProgramRevisions",
        "closureDigest"
      ],
      "properties": {
        "offerRevisions": {
          "$ref": "#/$defs/ownerRevisionBindingSet"
        },
        "offerPriceRevisions": {
          "$ref": "#/$defs/ownerRevisionBindingSet"
        },
        "entitlementTemplateRevisions": {
          "$ref": "#/$defs/ownerRevisionBindingSet"
        },
        "creditProgramRevisions": {
          "$ref": "#/$defs/ownerRevisionBindingSet"
        },
        "closureDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "hubClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityAssignment",
        "capabilityCatalog",
        "agentCatalog",
        "closureDigest"
      ],
      "properties": {
        "capabilityAssignment": {
          "$ref": "#/$defs/ownerRevisionBinding"
        },
        "capabilityCatalog": {
          "$ref": "#/$defs/ownerRevisionBinding"
        },
        "agentCatalog": {
          "$ref": "#/$defs/ownerRevisionBinding"
        },
        "closureDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "businessBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "webBuildMaterialBundle",
        "siteConfig",
        "legalPolicy",
        "salesPolicy",
        "assortmentPolicy",
        "memoryPolicy",
        "authIdentityClosure",
        "commerceClosure",
        "hubClosure"
      ],
      "properties": {
        "webBuildMaterialBundle": {
          "$ref": "#/$defs/revisionBinding"
        },
        "siteConfig": {
          "$ref": "#/$defs/ownerRevisionBinding"
        },
        "legalPolicy": {
          "$ref": "#/$defs/ownerRevisionBinding"
        },
        "salesPolicy": {
          "$ref": "#/$defs/ownerRevisionBinding"
        },
        "assortmentPolicy": {
          "$ref": "#/$defs/ownerRevisionBinding"
        },
        "memoryPolicy": {
          "$ref": "#/$defs/ownerRevisionBinding"
        },
        "authIdentityClosure": {
          "$ref": "#/$defs/authIdentityClosure"
        },
        "commerceClosure": {
          "$ref": "#/$defs/commerceClosure"
        },
        "hubClosure": {
          "$ref": "#/$defs/hubClosure"
        }
      }
    },
    "modelRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelRoleRef",
        "modelInventory",
        "modelCatalog"
      ],
      "properties": {
        "modelRoleRef": {
          "$ref": "#/$defs/ref"
        },
        "modelInventory": {
          "$ref": "#/$defs/digestRef"
        },
        "modelCatalog": {
          "$ref": "#/$defs/digestRef"
        }
      }
    },
    "revisionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "revision",
        "digest"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "revision": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "candidateAuthorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "version",
        "authorizationEpoch",
        "digest"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "version": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "authorizationEpoch": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
