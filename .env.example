# Platform API Compose host-file references. Values are paths, never secret material.
# Compose mounts each source at the canonical read-only path under
# /run/secrets/platform-api. Private material must use 0400/0600 for the runtime UID
# or 0440/0640 for its dedicated GID; execute and world access are rejected. Regular
# registries/certificates must be owner-readable and never group/world-writable (0440 recommended).
PLATFORM_RUNTIME_UID=1000
PLATFORM_RUNTIME_GID=1000
PLATFORM_PRODUCT_WORKLOAD_REGISTRY_FILE=/srv/kokoro/secrets/platform-api/product-workloads.json
PLATFORM_SESSION_ACCESS_KEY_RING_FILE=/srv/kokoro/secrets/platform-api/session-access-keys.json
PLATFORM_AUTHORIZATION_EVENT_KEY_RING_FILE=/srv/kokoro/secrets/platform-api/authorization-event-keys.json
PLATFORM_PUBLIC_TLS_KEY_FILE=/srv/kokoro/secrets/platform-api/public-tls.key
PLATFORM_PUBLIC_TLS_CERT_FILE=/srv/kokoro/secrets/platform-api/public-tls.crt
PLATFORM_PUBLIC_TLS_CLIENT_CA_FILE=/srv/kokoro/secrets/platform-api/public-client-ca.crt
PLATFORM_COMMERCE_REDEMPTION_KEY_RING_FILE=/srv/kokoro/secrets/platform-api/commerce-redemption-keys.json
PLATFORM_ASSET_UPLOAD_POLICY_REGISTRY_FILE=/srv/kokoro/secrets/platform-api/asset-upload-policies.json
PLATFORM_ASSET_UPLOAD_CAPABILITY_KEY_RING_FILE=/srv/kokoro/secrets/platform-api/asset-upload-capability-keys.json
PLATFORM_IDENTITY_PASSWORD_PEPPER_RING_FILE=/srv/kokoro/secrets/platform-api/identity-password-peppers.json
PLATFORM_IDENTITY_VERIFICATION_DIGEST_KEY_FILE=/srv/kokoro/secrets/platform-api/identity-verification-digest.key
PLATFORM_IDENTITY_SESSION_DIGEST_KEY_FILE=/srv/kokoro/secrets/platform-api/identity-session-digest.key
PLATFORM_IDENTITY_REFRESH_DIGEST_KEY_FILE=/srv/kokoro/secrets/platform-api/identity-refresh-digest.key
PLATFORM_IDENTITY_REAUTH_DIGEST_KEY_FILE=/srv/kokoro/secrets/platform-api/identity-reauth-digest.key
PLATFORM_IDENTITY_AUDIT_DIGEST_KEY_FILE=/srv/kokoro/secrets/platform-api/identity-audit-digest.key
PLATFORM_IDENTITY_DELIVERY_KEY_FILE=/srv/kokoro/secrets/platform-api/identity-delivery.key
PLATFORM_IDENTITY_TOTP_KEY_RING_FILE=/srv/kokoro/secrets/platform-api/identity-totp-keys.json

# Dedicated private Admission Connect deployable. Secret values are always
# mounted files; only references and internal service coordinates live here.
PLATFORM_ADMISSION_PORT=4244
PLATFORM_ADMISSION_ENVIRONMENT=production
PLATFORM_ADMISSION_REGION=us-east-1
PLATFORM_ADMISSION_GA_DISPATCH_AUDIENCE=kokoro-ga-dispatch
PLATFORM_ADMISSION_TLS_KEY_FILE=/run/secrets/platform-admission/server.key
PLATFORM_ADMISSION_TLS_CERT_FILE=/run/secrets/platform-admission/server.crt
PLATFORM_ADMISSION_TLS_CLIENT_CA_FILE=/run/secrets/platform-admission/client-ca.crt
PLATFORM_ADMISSION_MTLS_PEERS_FILE=/run/secrets/platform-admission/inbound-peers.json
PLATFORM_ASSET_ELIGIBILITY_SESSION_CALLER_SAN_URI=spiffe://kokoro/session
PLATFORM_ADMISSION_HPKE_PUBLIC_KEY_RING_FILE=/run/secrets/platform-admission/ga-hpke-public-keys.json
PLATFORM_ADMISSION_OUTBOUND_TLS_KEY_FILE=/run/secrets/platform-admission/client.key
PLATFORM_ADMISSION_OUTBOUND_TLS_CERT_FILE=/run/secrets/platform-admission/client.crt
PLATFORM_ADMISSION_SESSION_CA_FILE=/run/secrets/platform-admission/session-ca.crt
PLATFORM_ADMISSION_AGENT_CA_FILE=/run/secrets/platform-admission/agent-ca.crt
PLATFORM_ADMISSION_SESSION_BASE_URL=https://kokoro-session.internal:7443
PLATFORM_ADMISSION_SESSION_SERVER_NAME=kokoro-session.internal
PLATFORM_ADMISSION_AGENT_BASE_URL=https://kokoro-agent.internal:7444
PLATFORM_ADMISSION_AGENT_SERVER_NAME=kokoro-agent.internal

# Dedicated ConnectRPC Model Gateway. Only the exact Agent SPIFFE identity may invoke it.
PLATFORM_MODEL_GATEWAY_PORT=4247
PLATFORM_DATABASE_MODEL_GATEWAY_ROLE=platform_model_gateway
PLATFORM_MODEL_GATEWAY_LITELLM_ENDPOINT=https://litellm.internal/v1
PLATFORM_MODEL_GATEWAY_PROVIDER_TIMEOUT_MS=30000
PLATFORM_MODEL_GATEWAY_TLS_KEY_FILE=/run/secrets/platform-model-gateway/server.key
PLATFORM_MODEL_GATEWAY_TLS_CERT_FILE=/run/secrets/platform-model-gateway/server.crt
PLATFORM_MODEL_GATEWAY_TLS_CLIENT_CA_FILE=/run/secrets/platform-model-gateway/client-ca.crt
PLATFORM_MODEL_GATEWAY_MTLS_PEERS_FILE=/run/secrets/platform-model-gateway/inbound-peers.json
PLATFORM_MODEL_GATEWAY_AGENT_CALLER_SAN_URI=spiffe://kokoro.internal/agent
PLATFORM_MODEL_GATEWAY_RESPONSE_KEY_RING_FILE=/run/secrets/platform-model-gateway/response-key-ring.json
PLATFORM_MODEL_GATEWAY_LITELLM_API_KEY_FILE=/run/secrets/platform-model-gateway/litellm-api-key

# Hub private Connect runtime and durable signed capability projection.
# Compose-only host mount sources (the mounted files/directories are read-only).
KOKORO_HUB_CONNECT_SECRETS_DIRECTORY=/srv/kokoro/secrets/hub-connect
KOKORO_WORKSPACE_CONFIG_FILE=/srv/kokoro/config/storage.yaml
KOKORO_HUB_CONNECT_PORT=4252
KOKORO_HUB_CONNECT_HEALTH_PORT=4253
KOKORO_HUB_MONGO_URL=mongodb://mongo.internal:27017
KOKORO_HUB_MONGO_DB=kokoro_hub
KOKORO_WORKSPACE_CONFIG=/run/config/kokoro/storage.yaml
KOKORO_WORKSPACE_S3_ACCESS_KEY=example-access-key
KOKORO_WORKSPACE_S3_SECRET_KEY=example-secret-key
KOKORO_HUB_SECRET_MASTER_KEY=ZXhhbXBsZS1vbmx5LWtleS0zMi1ieXRlcy0wMDAwMDA=
KOKORO_HUB_CONNECT_TRUST_ROOT=/run/secrets/hub-connect
KOKORO_HUB_CONNECT_TLS_KEY_FILE=/run/secrets/hub-connect/server.key
KOKORO_HUB_CONNECT_TLS_CERT_FILE=/run/secrets/hub-connect/server.crt
KOKORO_HUB_CONNECT_TLS_CLIENT_CA_FILE=/run/secrets/hub-connect/client-ca.crt
KOKORO_HUB_CONNECT_MTLS_PEERS_FILE=/run/secrets/hub-connect/inbound-peers.json
KOKORO_HUB_CATALOG_PLATFORM_CALLER_SAN_URI=spiffe://kokoro.internal/platform
KOKORO_HUB_RUNTIME_AGENT_CALLER_SAN_URI=spiffe://kokoro.internal/agent
KOKORO_HUB_CAPABILITY_SIGNING_KEY_REF=hub-signing:revision:1
KOKORO_HUB_CAPABILITY_SIGNING_KEY_FILE=/run/secrets/hub-connect/catalog-signing.key
KOKORO_HUB_PLATFORM_PROJECTION_BASE_URL=https://platform-admission.internal:4244
KOKORO_HUB_PLATFORM_PROJECTION_SERVER_NAME=platform-admission.internal
KOKORO_HUB_PLATFORM_PROJECTION_CLIENT_KEY_FILE=/run/secrets/hub-connect/platform-client.key
KOKORO_HUB_PLATFORM_PROJECTION_CLIENT_CERT_FILE=/run/secrets/hub-connect/platform-client.crt
KOKORO_HUB_PLATFORM_PROJECTION_SERVER_CA_FILE=/run/secrets/hub-connect/platform-ca.crt
