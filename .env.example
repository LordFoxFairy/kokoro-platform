# Platform API secret-file references. Values are paths, never secret material.
PLATFORM_IDENTITY_TOTP_KEY_RING_FILE=/run/secrets/platform/identity-totp-key-ring.json
PLATFORM_IDENTITY_REAUTH_DIGEST_KEY_FILE=/run/secrets/platform/identity-reauth-digest-key

# The TOTP key-ring file is mandatory for platform-api startup, must be a regular
# non-symlink file with no group/world permission bits (0400 recommended), and
# must validate against config/secrets/identity-totp-key-ring.schema.json.
