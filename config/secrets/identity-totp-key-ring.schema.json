{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokoro.example/schemas/identity-totp-key-ring.schema.json",
  "title": "Kokoro Identity TOTP Encryption Key Ring",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "currentKeyRevision", "keys"],
  "properties": {
    "version": { "const": 1 },
    "currentKeyRevision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyRevision", "keyBase64url"],
        "properties": {
          "keyRevision": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "keyBase64url": {
            "type": "string",
            "description": "Exactly 32 random bytes encoded as canonical unpadded base64url.",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      }
    }
  }
}
