{
  "version": 1,
  "secretClass": "identity-totp-encryption-keyring",
  "consumerDeployable": "platform-api",
  "environmentVariable": "PLATFORM_IDENTITY_TOTP_KEY_RING_FILE",
  "mountPath": "/run/secrets/platform/identity-totp-key-ring.json",
  "recommendedFileMode": "0400",
  "schema": "./identity-totp-key-ring.schema.json",
  "rotation": {
    "writeWith": "currentKeyRevision",
    "readWith": "all listed key revisions",
    "retireOldRevisionAfter": "all pending enrollment TTLs and retained envelopes have expired"
  }
}
