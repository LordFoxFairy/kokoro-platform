{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokoro.local/schemas/site-release-certification-keys.schema.json",
  "title": "Site release certification verification keys",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "keys"],
  "properties": {
    "version": { "const": 1 },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signingKeyRef", "algorithm", "publicKeyPem"],
        "properties": {
          "signingKeyRef": { "type": "string", "minLength": 3, "maxLength": 256 },
          "algorithm": { "const": "Ed25519" },
          "publicKeyPem": { "type": "string", "minLength": 1, "maxLength": 8192 }
        }
      }
    }
  }
}
