{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kokoro Model Gateway response encryption key ring",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "currentKeyRevision", "keys"],
  "properties": {
    "version": { "const": 1 },
    "currentKeyRevision": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyRevision", "keyBase64url"],
        "properties": {
          "keyRevision": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
          "keyBase64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
        }
      }
    }
  }
}
