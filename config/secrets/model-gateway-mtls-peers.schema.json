{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kokoro Model Gateway inbound mTLS peers",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "peers"],
  "properties": {
    "version": { "const": 1 },
    "peers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint256", "sanUri"],
        "properties": {
          "fingerprint256": {
            "type": "string",
            "pattern": "^(?:[0-9A-F]{2}:){31}[0-9A-F]{2}$"
          },
          "sanUri": { "type": "string", "pattern": "^spiffe://" }
        }
      }
    }
  }
}
