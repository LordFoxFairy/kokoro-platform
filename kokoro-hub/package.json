{
  "name": "@kokoro/hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx src/interfaces/http/main.ts",
    "start": "tsx src/interfaces/http/main.ts",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "coverage": "vitest run --coverage --no-file-parallelism"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@fastify/multipart": "^9.2.1",
    "@kokoro/platform-kit": "workspace:*",
    "@kokoro/user": "workspace:*",
    "fastify": "^5.10.0",
    "fflate": "^0.8.2",
    "ipaddr.js": "2.4.0",
    "mongodb": "^6.12.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
