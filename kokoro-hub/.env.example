KOKORO_HUB_PORT=4251
KOKORO_HUB_BASE_URL="http://kokoro-hub:4251"
# 能力中台元数据库（Mongo）。hub 写、agent 读，读写分离同库；示例用本地明显假值，勿用于生产。
KOKORO_HUB_MONGO_URL="mongodb://127.0.0.1:27017"
KOKORO_HUB_MONGO_DB="kokoro_hub"
# 每 namespace 上传配额上限（包数 / 字节合计）；confirm 发布时按项强制。
KOKORO_HUB_QUOTA_MAX_PACKAGES=100
KOKORO_HUB_QUOTA_MAX_BYTES=209715200
# ADR-009 存储 yaml（hub 只取 hub 节做 skills 包体权威源）；不配置 = 上传 confirm 面 503。
# KOKORO_WORKSPACE_CONFIG="/etc/kokoro/storage.yaml"
# s3 档凭据（env-only，与 agent 侧同名复用；示例为明显假值）。
# KOKORO_WORKSPACE_S3_ACCESS_KEY="example-access-key"
# KOKORO_WORKSPACE_S3_SECRET_KEY="example-secret-key"
# MCP secret 信封加密主密钥（32B base64，env-only，永不进配置/日志）；缺省 = secret broker 503。
# 生成：openssl rand -base64 32；示例为明显假值，勿用于生产。
# KOKORO_HUB_SECRET_MASTER_KEY="ZXhhbXBsZS1tYXN0ZXIta2V5LTMyLWJ5dGVzLXBhZGRpbmc="
# 轮换双读的历史主密钥（逗号分隔 base64，各 32B）：新写用 primary，旧信封按 key_id 仍可解。
# KOKORO_HUB_SECRET_MASTER_KEY_PREVIOUS="ZXhhbXBsZS1wcmV2aW91cy1rZXktMzItYnl0ZXMtcGFkISE="
# mcp_servers admin/official 面 env: 引用白名单（逗号分隔 VAR 名）；不在表的 env:VAR 注册 400。
# KOKORO_HUB_ENV_REF_ALLOWLIST="GH_MCP_TOKEN,SLACK_MCP_TOKEN"
# 放行 http/localhost/私网 url 注册（仅 admin 面 + 本地/test）；"1" 开启，缺省关闭。
# KOKORO_HUB_ALLOW_INSECURE_URL="1"
# self 面 MCP mutation 部署门（HUB-CONSIST）：仅 "on" 开放 web-bff 的 servers 注册/启停/删；
# 缺省关闭 = 恒 503 capability_registration_disabled（fail-closed，跨仓 E2E 过后再开）。
# KOKORO_HUB_MCP_MUTATION="on"
