// admin-web 连同一个 admin DB（schema owner = 网关仓）；此处只映射登录所需的表，不拥有迁移。
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL_ADMIN")
}

generator client {
  provider = "prisma-client-js"
}

// 只读：magic-link 登录邮箱必须命中一个 active 的运营账号（授权仍由网关 RBAC 决定）。
model OperatorAccount {
  id          String @id @default(cuid())
  email       String @unique
  displayName String
  roleKey     String
  status      String

  @@map("operator_accounts")
}

// Auth.js 一次性令牌存储（自定义 adapter 读写）。
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// 登录/登出/被拒 审计（events 回调写入）。
model AuthEvent {
  id        String   @id @default(cuid())
  email     String
  event     String
  ip        String?
  userAgent String?
  reason    String?
  createdAt DateTime @default(now())

  @@map("auth_events")
}
