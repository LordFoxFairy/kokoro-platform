# admin-web（Next.js BFF）env。复制为 .env.local 填真实值。lib/env.ts 启动即校验，缺项 fail-fast。

# Auth.js —— 会话签名密钥（openssl rand -base64 32 生成，务必轮换）
AUTH_SECRET=

# 规范化访问域，确保 magic-link/回调/cookie 同一 host（避免 127.0.0.1 vs localhost cookie 不互通）
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# admin DB（只读映射 OperatorAccount + 读写 VerificationToken/AuthEvent；schema owner = 网关仓）
DATABASE_URL_ADMIN=mysql://user:pass@127.0.0.1:3307/kokoro_admin

# 守门人网关（BFF 反代目标）
KOKORO_GATEWAY_URL=http://127.0.0.1:4290

# BFF→网关 proxy 模式共享密钥（须与网关 KOKORO_ADMIN_PROXY_SECRETS 之一一致）
KOKORO_ADMIN_PROXY_SECRET=

# magic-link 有效期（秒），默认 600
MAGIC_LINK_MAX_AGE=600

# 发信：dev 留空则 magic-link 打 server console；生产必填 SMTP（lib/env.ts 强制）
EMAIL_FROM=no-reply@kokoro.local
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
