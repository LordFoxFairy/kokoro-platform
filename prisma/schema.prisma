generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/platform-prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["platform"]
}

/// Migration-owned marker for the single Platform PostgreSQL authority.
/// Owner module tables are added to this schema by subsequent migrations.
model PlatformFoundation {
  singleton     Boolean  @id @default(true)
  schemaVersion Int
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@map("platform_foundation")
  @@schema("platform")
}

model CommandReceipt {
  commandId      String   @id @map("command_id")
  environment    String
  region         String
  callerIdentity String   @map("caller_identity")
  operation      String
  idempotencyKey String   @map("idempotency_key")
  requestDigest  String   @map("request_digest") @db.Char(64)
  state          String   @default("pending")
  result         Json?
  resultDigest   String?  @map("result_digest") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([environment, callerIdentity, operation, idempotencyKey])
  @@map("command_receipt")
  @@schema("platform")
}

model AdminOperatorAuthority {
  operatorRef         String    @map("operator_ref")
  operatorGeneration  BigInt    @map("operator_generation")
  state               String
  permissions         String[]
  siteScopes          String[]  @map("site_scopes")
  environments        String[]
  regions             String[]
  authorizationEpoch  BigInt    @map("authorization_epoch")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  breakGlassExpiresAt DateTime? @map("break_glass_expires_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([operatorRef, operatorGeneration])
  @@index([state, expiresAt])
  @@map("admin_operator_authority")
  @@schema("platform")
}

model AdminAuthorityBootstrap {
  singleton           Boolean   @id @default(true)
  state               String    @default("open")
  configurationDigest String?   @map("configuration_digest") @db.Char(64)
  sealedAt            DateTime? @map("sealed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("admin_authority_bootstrap")
  @@schema("platform")
}

model AdminCommandDecision {
  decisionRef          String   @id @map("decision_ref") @db.Uuid
  commandId            String   @map("command_id")
  requestDigest        String   @map("request_digest") @db.Char(64)
  operatorRef          String   @map("operator_ref")
  operatorGeneration   BigInt   @map("operator_generation")
  operation            String
  targetSiteRef        String?  @map("target_site_ref")
  environment          String
  region               String
  allowed              Boolean
  reasonCode           String   @map("reason_code")
  effectClass          String   @map("effect_class")
  approvalPolicy       String   @map("approval_policy")
  operatorReason       String?  @map("operator_reason")
  breakGlassTicketRef  String?  @map("break_glass_ticket_ref")
  authorizationEpoch  BigInt?  @map("authorization_epoch")
  occurredAt           DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([operatorRef, occurredAt])
  @@index([targetSiteRef, occurredAt])
  @@map("admin_command_decision")
  @@schema("platform")
}

model AdminApproval {
  approvalRef              String    @id @map("approval_ref") @db.Uuid
  commandId                String    @unique @map("command_id")
  requestDigest            String    @map("request_digest") @db.Char(64)
  payload                  Json
  payloadDigest            String    @map("payload_digest") @db.Char(64)
  operation                String
  makerRef                 String    @map("maker_ref")
  makerGeneration          BigInt    @map("maker_generation")
  makerAuthorizationEpoch BigInt    @map("maker_authorization_epoch")
  targetSiteRef            String?   @map("target_site_ref")
  environment              String
  region                   String
  effectClass              String    @map("effect_class")
  approvalPolicy           String    @map("approval_policy")
  operatorReason           String    @map("operator_reason")
  admittedAt               DateTime  @map("admitted_at") @db.Timestamptz(6)
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(6)
  state                    String    @default("pending")
  revision                 BigInt    @default(1)
  checkerRef               String?   @map("checker_ref")
  checkerGeneration        BigInt?   @map("checker_generation")
  checkerAuthorizationEpoch BigInt?  @map("checker_authorization_epoch")
  checkerDecision          String?   @map("checker_decision")
  checkerReason            String?   @map("checker_reason")
  result                   Json?
  resultDigest             String?   @map("result_digest") @db.Char(64)
  terminalReason           String?   @map("terminal_reason")
  decidedAt                DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([environment, region, targetSiteRef, state, expiresAt])
  @@map("admin_approval")
  @@schema("platform")
}

model AdminPostEffectReview {
  reviewRef                 String    @id @map("review_ref") @db.Uuid
  commandId                 String    @unique @map("command_id")
  requestDigest             String    @map("request_digest") @db.Char(64)
  operation                 String
  requiredPermission        String    @map("required_permission")
  makerRef                  String    @map("maker_ref")
  makerGeneration           BigInt    @map("maker_generation")
  makerAuthorizationEpoch   BigInt    @map("maker_authorization_epoch")
  targetSiteRef             String?   @map("target_site_ref")
  environment               String
  region                    String
  breakGlassTicketRef       String    @map("break_glass_ticket_ref")
  outcome                   Json
  outcomeDigest             String    @map("outcome_digest") @db.Char(64)
  state                     String    @default("pending")
  reviewerRef               String?   @map("reviewer_ref")
  reviewerGeneration        BigInt?   @map("reviewer_generation")
  reviewerAuthorizationEpoch BigInt?  @map("reviewer_authorization_epoch")
  reviewerReason            String?   @map("reviewer_reason")
  terminalReason            String?   @map("terminal_reason")
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt                 DateTime  @map("expires_at") @db.Timestamptz(6)
  reviewedAt                DateTime? @map("reviewed_at") @db.Timestamptz(6)
  revision                  BigInt    @default(1)

  @@index([environment, region, targetSiteRef, state, expiresAt])
  @@map("admin_post_effect_review")
  @@schema("platform")
}

model AdminApprovalDecision {
  decisionRef        String   @id @map("decision_ref") @db.Uuid
  approvalRef        String   @map("approval_ref")
  executionCommandId String   @map("execution_command_id")
  checkerRef         String   @map("checker_ref")
  checkerGeneration  BigInt   @map("checker_generation")
  checkerAuthorizationEpoch BigInt? @map("checker_authorization_epoch")
  targetSiteRef      String?  @map("target_site_ref")
  environment        String
  region             String
  allowed            Boolean
  reasonCode         String   @map("reason_code")
  requestDigest      String   @map("request_digest") @db.Char(64)
  occurredAt         DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([approvalRef, occurredAt])
  @@map("admin_approval_decision")
  @@schema("platform")
}

model AdmissionCommand {
  siteId          String    @map("site_id")
  operation       String
  commandId       String    @map("command_id")
  environment     String
  region          String
  callerIdentity  String    @map("caller_identity")
  idempotencyKey  String    @map("idempotency_key")
  requestDigest   String    @map("request_digest") @db.Char(64)
  state           String    @default("processing")
  leaseToken      String?   @map("lease_token") @db.Uuid
  leaseExpiresAt  DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  responsePayload Bytes?    @map("response_payload")
  responseDigest  String?   @map("response_digest") @db.Char(64)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([siteId, operation, commandId])
  @@unique([environment, callerIdentity, siteId, operation, idempotencyKey])
  @@map("admission_command")
  @@schema("platform")
}

model OutboxEvent {
  eventId        String    @id @map("event_id") @db.Uuid
  owner          String
  eventType      String    @map("event_type")
  aggregateId    String    @map("aggregate_id")
  payload        Json
  payloadDigest  String    @map("payload_digest") @db.Char(64)
  correlationId  String    @map("correlation_id")
  causationId    String?   @map("causation_id")
  state          String    @default("pending")
  attempt        Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseOwner     String?   @map("lease_owner")
  leaseToken     String?   @map("lease_token")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  lastErrorCode  String?   @map("last_error_code")
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz(6)
  consumerDeliveryId String? @map("consumer_delivery_id")
  consumerAcknowledgedAt DateTime? @map("consumer_acknowledged_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("outbox_event")
  @@schema("platform")
}

model InboxDelivery {
  deliveryId          String    @id @map("delivery_id") @db.Uuid
  provider            String
  operation           String
  idempotencyKey      String    @map("idempotency_key")
  requestDigest       String    @map("request_digest") @db.Char(64)
  state               String    @default("processing")
  handlerId           String?   @map("handler_id")
  leaseToken          String?   @map("lease_token")
  leaseExpiresAt      DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  attempt             Int       @default(0)
  outcome             Json?
  outcomeDigest       String?   @map("outcome_digest") @db.Char(64)
  lastObservationCode String?   @map("last_observation_code")
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, operation, idempotencyKey])
  @@map("inbox_delivery")
  @@schema("platform")
}

model ModelInventoryImport {
  importId         String   @id @map("import_id") @db.Uuid
  sourceDigest     String   @unique @map("source_digest") @db.Char(64)
  schemaVersion    Int      @map("schema_version")
  sourceKind       String   @map("source_kind")
  sourceReference  String   @map("source_reference")
  canonicalPayload Json     @map("canonical_payload")
  counts           Json
  importedBy       String   @map("imported_by")
  importedAt       DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@unique([importId, sourceDigest])
  @@map("model_inventory_import")
  @@schema("platform")
}

model ModelInventoryActivation {
