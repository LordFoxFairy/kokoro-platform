model AuthorizationScopedEventLog {
  streamSequence     BigInt   @id @map("stream_sequence")
  eventId            String   @unique @map("event_id") @db.Uuid
  siteRef            String   @map("site_ref")
  aggregateSequence  BigInt   @map("aggregate_sequence")
  eventType          String   @map("event_type")
  occurredAt         DateTime @map("occurred_at") @db.Timestamptz(6)
  signingPayload     Bytes    @map("signing_payload")
