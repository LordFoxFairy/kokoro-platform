  checksumSha256        String   @map("checksum_sha256") @db.Char(64)
  size                  BigInt
  state                 String
  eligibilityEpoch      BigInt   @map("eligibility_epoch")
  createdAt             DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([siteRef, assetVersionRef])
  @@index([siteRef, assetRef, state, createdAt])
  @@map("asset_version")
  @@schema("platform")
}

model AssetReference {
  referenceRef    String    @id @map("reference_ref")
  siteRef         String    @map("site_ref")
  assetVersionRef String    @map("asset_version_ref")
  ownerContext    String    @map("owner_context")
  resourceRef     String    @map("resource_ref")
  resourceVersion BigInt    @map("resource_version")
  purpose         String
  state           String
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)
  releasedAt      DateTime? @map("released_at") @db.Timestamptz(6)

  @@unique([siteRef, ownerContext, resourceRef, resourceVersion, assetVersionRef, purpose])
  @@index([siteRef, ownerContext, resourceRef, resourceVersion, state])
  @@map("asset_reference")
  @@schema("platform")
}

model AssetEligibilityProjection {
  eligibilityRef    String   @id @map("eligibility_ref")
  siteRef           String   @map("site_ref")
  assetVersionRef   String   @unique @map("asset_version_ref")
  subjectRef        String   @map("subject_ref")
  subjectGeneration BigInt   @map("subject_generation")
  projectRef        String   @map("project_ref")
  purpose           String
  policyRevisionRef String   @map("policy_revision_ref")
  scanEvaluationRef String   @map("scan_evaluation_ref")
  eligibilityEpoch  BigInt   @map("eligibility_epoch")
  state             String
  createdAt         DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(6)

  @@unique([siteRef, assetVersionRef, eligibilityEpoch])
  @@index([siteRef, subjectRef, projectRef, purpose, state])
  @@map("asset_eligibility_projection")
  @@schema("platform")
}

model AssetPromotionReceipt {
  receiptRef                String   @id @map("receipt_ref")
  siteRef                   String   @map("site_ref")
  promotionRef              String   @unique @map("promotion_ref")
  assetRef                  String   @unique @map("asset_ref")
  assetVersionRef           String   @unique @map("asset_version_ref")
  blobRef                   String   @unique @map("blob_ref")
  trustedProviderVersionRef String   @map("trusted_provider_version_ref")
  checksumSha256            String   @map("checksum_sha256") @db.Char(64)
  completedAt               DateTime @map("completed_at") @db.Timestamptz(6)

  @@map("asset_promotion_receipt")
  @@schema("platform")
}
