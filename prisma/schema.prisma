generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/platform-prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["platform"]
}

/// Migration-owned marker for the single Platform PostgreSQL authority.
/// Owner module tables are added to this schema by subsequent migrations.
model PlatformFoundation {
  singleton             Boolean  @id @default(true)
  schemaVersion         Int
  outboxPolicyAuthority Json     @default("[]")
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)

  @@map("platform_foundation")
  @@schema("platform")
}

model RuntimeRoleIdentityAuthority {
  roleKind   String   @id @map("role_kind")
  roleName   String   @unique @map("role_name")
  roleOid    BigInt   @unique @map("role_oid")
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@map("runtime_role_identity_authority")
  @@schema("platform")
}

model MemorySpace {
  siteRef                         String   @map("site_ref")
  spaceRef                        String   @map("space_ref")
  scopeKind                       String   @map("scope_kind")
  parentSpaceRef                  String?  @map("parent_space_ref")
  parentSpaceGeneration           BigInt?  @map("parent_space_generation")
  parentLearningGeneration        BigInt?  @map("parent_learning_generation")
  parentRevocationEpoch           BigInt?  @map("parent_revocation_epoch")
  subjectRef                      String?  @map("subject_ref")
  subjectGeneration               BigInt?  @map("subject_generation")
  projectRef                      String?  @map("project_ref")
  agentOptionRef                  String?  @map("agent_option_ref")
  productSurfaceRef               String?  @map("product_surface_ref")
  featurePolicyRevisionRef        String   @map("feature_policy_revision_ref")
  version                         BigInt
  spaceGeneration                 BigInt   @map("space_generation")
  learningGeneration              BigInt   @map("learning_generation")
  revocationEpoch                 BigInt   @map("revocation_epoch")
  minimumLearnableSourceOriginSeq BigInt   @map("minimum_learnable_source_origin_seq")
  learningState                   String   @map("learning_state")
  useState                        String   @map("use_state")
  state                           String
  createdAt                       DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime @map("updated_at") @db.Timestamptz(6)

  @@id([siteRef, spaceRef])
  @@index([siteRef, subjectRef, subjectGeneration, scopeKind, state])
  @@index([siteRef, projectRef, scopeKind, state])
  @@map("memory_space")
  @@schema("platform")
}

model MemoryEntry {
  siteRef                  String    @map("site_ref")
  spaceRef                 String    @map("space_ref")
  entryRef                 String    @map("entry_ref")
  version                  BigInt
  currentRevision          BigInt    @map("current_revision")
  currentRevisionRef       String    @map("current_revision_ref")
  state                    String
  category                 String
  prioritized              Boolean   @default(false)
  featurePolicyRevisionRef String    @map("feature_policy_revision_ref")
  spaceGeneration          BigInt    @map("space_generation")
  learningGeneration       BigInt    @map("learning_generation")
  revocationEpoch          BigInt    @map("revocation_epoch")
  createdAt                DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@id([siteRef, spaceRef, entryRef])
  @@unique([siteRef, entryRef])
  @@index([siteRef, spaceRef, state, currentRevision])
  @@map("memory_entry")
  @@schema("platform")
}

model MemoryRevision {
  siteRef                  String   @map("site_ref")
  spaceRef                 String   @map("space_ref")
  entryRef                 String   @map("entry_ref")
  revision                 BigInt
  revisionRef              String   @map("revision_ref")
  reason                   String
  supersedesRevision       BigInt?  @map("supersedes_revision")
  supersedesRevisionRef    String?  @map("supersedes_revision_ref")
  restoredFromRevisionRef  String?  @map("restored_from_revision_ref")
  validFrom                DateTime? @map("valid_from") @db.Timestamptz(6)
  validTo                  DateTime? @map("valid_to") @db.Timestamptz(6)
  featurePolicyRevisionRef String   @map("feature_policy_revision_ref")
  recordedAt               DateTime @map("recorded_at") @db.Timestamptz(6)

  @@id([siteRef, spaceRef, entryRef, revision])
  @@unique([siteRef, revisionRef])
  @@map("memory_revision")
  @@schema("platform")
}

model MemoryRevisionPayload {
  siteRef               String   @map("site_ref")
  spaceRef              String   @map("space_ref")
  entryRef              String   @map("entry_ref")
  revision              BigInt
  revisionRef           String   @map("revision_ref")
  envelopeVersion       Int      @map("envelope_version") @db.SmallInt
  protectionKeyRevision String   @map("protection_key_revision")
  nonce                 Bytes
  protectedCiphertext   Bytes    @map("protected_ciphertext")
  authenticationTag     Bytes    @map("authentication_tag")
  aadDigest             String   @map("aad_digest") @db.Char(64)
  protectedAt           DateTime @map("protected_at") @db.Timestamptz(6)

  @@id([siteRef, spaceRef, entryRef, revision, revisionRef])
  @@map("memory_revision_payload")
  @@schema("platform")
}

model MemoryProvenance {
  siteRef                 String   @map("site_ref")
  spaceRef                String   @map("space_ref")
  entryRef                String   @map("entry_ref")
  revision                BigInt
  revisionRef             String   @map("revision_ref")
  provenanceRef           String   @map("provenance_ref")
  sourceKind              String   @map("source_kind")
  sourceRef               String   @map("source_ref")
  sourceDigest            String   @map("source_digest") @db.Char(64)
  sourceDigestKeyRevision String?  @map("source_digest_key_revision")
  actorSubjectRef         String   @map("actor_subject_ref")
  actorSubjectGeneration  BigInt   @map("actor_subject_generation")
  actorProjectRef         String?  @map("actor_project_ref")
  actorMembershipEpoch    BigInt?  @map("actor_membership_epoch")
  actorAuthorizationEpoch BigInt?  @map("actor_authorization_epoch")
  recordedAt              DateTime @map("recorded_at") @db.Timestamptz(6)

  @@id([siteRef, spaceRef, entryRef, revision, provenanceRef])
  @@unique([siteRef, provenanceRef])
  @@map("memory_provenance")
  @@schema("platform")
}

model MemoryCommandReceipt {
  receiptId                              BigInt   @id @default(autoincrement()) @map("receipt_id")
  siteRef                                String   @map("site_ref")
  ownerScopeKind                         String   @map("owner_scope_kind")
  ownerSubjectRef                        String?  @map("owner_subject_ref")
  ownerSubjectGeneration                 BigInt?  @map("owner_subject_generation")
  ownerProjectRef                        String?  @map("owner_project_ref")
  callerSubjectRef                       String   @map("caller_subject_ref")
  callerSubjectGeneration                BigInt   @map("caller_subject_generation")
  callerMembershipEpoch                  BigInt?  @map("caller_membership_epoch")
  callerAuthorizationEpoch               BigInt?  @map("caller_authorization_epoch")
  commandRef                             String   @map("command_ref")
  operation                              String
  requestDigest                          String   @map("request_digest") @db.Char(64)
  requestDigestKeyRevision               String?  @map("request_digest_key_revision")
  resultKind                             String   @map("result_kind")
  resultSpaceRef                         String   @map("result_space_ref")
  resultSpaceVersion                     BigInt   @map("result_space_version")
  resultEntryRef                         String?  @map("result_entry_ref")
  resultEntryVersion                     BigInt?  @map("result_entry_version")
  resultRevisionRef                      String?  @map("result_revision_ref")
  resultRevision                         BigInt?  @map("result_revision")
  resultRestoredFromRevisionRef           String?  @map("result_restored_from_revision_ref")
  resultPrioritized                      Boolean? @map("result_prioritized")
  resultChanged                          Boolean? @map("result_changed")
  resultSpaceGeneration                  BigInt?  @map("result_space_generation")
  resultLearningGeneration               BigInt?  @map("result_learning_generation")
  resultRevocationEpoch                  BigInt?  @map("result_revocation_epoch")
  resultMinimumSourceOriginSeq           BigInt?  @map("result_minimum_source_origin_seq")
  resultLearningState                    String?  @map("result_learning_state")
  resultUseState                         String?  @map("result_use_state")
  resultPreviousFeaturePolicyRevisionRef String?  @map("result_previous_feature_policy_revision_ref")
  resultFeaturePolicyRevisionRef         String?  @map("result_feature_policy_revision_ref")
  recordedAt                             DateTime @map("recorded_at") @db.Timestamptz(6)

  @@index([siteRef, ownerScopeKind, ownerSubjectRef, ownerSubjectGeneration, ownerProjectRef, recordedAt])
  @@map("memory_command_receipt")
  @@schema("platform")
}

model MemoryPublicCommandInbox {
  siteRef                String    @map("site_ref")
  commandRef             String    @map("command_ref")
  ownerScopeKind         String    @map("owner_scope_kind")
  ownerSubjectRef        String?   @map("owner_subject_ref")
  ownerSubjectGeneration BigInt?   @map("owner_subject_generation")
  ownerProjectRef        String?   @map("owner_project_ref")
  operation              String
  requestDigest          String    @map("request_digest") @db.Char(64)
  requestDigestKeyRevision String  @map("request_digest_key_revision")
  requestPayloadKeyRevision String @map("request_payload_key_revision")
  requestPayloadDigest   String    @map("request_payload_digest") @db.Char(64)
  state                  String
  prepareRef             String?   @map("prepare_ref")
  expectedStateDigest    String?   @map("expected_state_digest") @db.Char(64)
  safeResultKind         String?   @map("safe_result_kind")
  resultRef              String?   @map("result_ref")
  committedSpaceVersion  BigInt?   @map("committed_space_version")
  resultEntryRef         String?   @map("result_entry_ref")
  resultEntryVersion     BigInt?   @map("result_entry_version")
  resultRevision         BigInt?   @map("result_revision")
  resultRevisionRef      String?   @map("result_revision_ref")
  resultRestoredFromRevisionRef String? @map("result_restored_from_revision_ref")
  resultPrioritized      Boolean?  @map("result_prioritized")
  resultChanged          Boolean?  @map("result_changed")
  authorityKeyRevision   String?   @map("authority_key_revision")
  authorityPayloadDigest String?   @map("authority_payload_digest") @db.Char(64)
  createdAt              DateTime  @map("created_at") @db.Timestamptz(6)
  completedAt            DateTime? @map("completed_at") @db.Timestamptz(6)

  @@id([siteRef, commandRef])
  @@map("memory_public_command_inbox")
  @@schema("platform")
}

model MemoryImportJob {
  siteRef                String    @map("site_ref")
  importRef              String    @map("import_ref")
  commandRef             String    @map("command_ref")
  ownerScopeKind         String    @map("owner_scope_kind")
  ownerSubjectRef        String?   @map("owner_subject_ref")
  ownerSubjectGeneration BigInt?   @map("owner_subject_generation")
  ownerProjectRef        String?   @map("owner_project_ref")
  uploadAssetRef         String    @map("upload_asset_ref")
  uploadAssetVersionRef  String    @map("upload_asset_version_ref")
  uploadDigest           String    @map("upload_digest") @db.Char(64)
  importFormat           String    @map("import_format")
  quarantineObjectRef    String    @map("quarantine_object_ref")
  state                  String
  attemptCount           Int       @default(0) @map("attempt_count")
  leaseEpoch             BigInt    @default(0) @map("lease_epoch")
  leaseTokenHash         String?   @map("lease_token_hash") @db.Char(64)
  leaseExpiresAt         DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  createdAt              DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @map("updated_at") @db.Timestamptz(6)

  @@id([siteRef, importRef])
  @@unique([siteRef, commandRef])
  @@map("memory_import_job")
  @@schema("platform")
}

model MemoryExportJob {
  siteRef                String    @map("site_ref")
  exportRef              String    @map("export_ref")
  commandRef             String    @map("command_ref")
  ownerScopeKind         String    @map("owner_scope_kind")
  ownerSubjectRef        String?   @map("owner_subject_ref")
  ownerSubjectGeneration BigInt?   @map("owner_subject_generation")
  ownerProjectRef        String?   @map("owner_project_ref")
  snapshotCutoff         BigInt    @map("snapshot_cutoff")
  exportFormat           String    @map("export_format")
  artifactRequestRef     String?   @map("artifact_request_ref")
  state                  String
  attemptCount           Int       @default(0) @map("attempt_count")
  leaseEpoch             BigInt    @default(0) @map("lease_epoch")
  leaseTokenHash         String?   @map("lease_token_hash") @db.Char(64)
  leaseExpiresAt         DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  expiresAt              DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt              DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @map("updated_at") @db.Timestamptz(6)

  @@id([siteRef, exportRef])
  @@unique([siteRef, commandRef])
  @@map("memory_export_job")
  @@schema("platform")
}

model MemoryPurgeParticipantManifest {
  manifestVersion BigInt @map("manifest_version")
  participantKey  String @map("participant_key")
  m0Applicability String @map("m0_applicability")

  @@id([manifestVersion, participantKey])
  @@map("memory_purge_participant_manifest")
  @@schema("platform")
}

model MemoryPurgeJob {
  siteRef                      String    @map("site_ref")
  purgeJobRef                  String    @map("purge_job_ref")
  commandRef                   String    @map("command_ref")
  spaceRef                     String    @map("space_ref")
  entryRef                     String?   @map("entry_ref")
  spaceGeneration              BigInt    @map("space_generation")
  learningGeneration           BigInt    @map("learning_generation")
  revocationEpoch              BigInt    @map("revocation_epoch")
  frozenManifestVersion        BigInt    @map("frozen_manifest_version")
  revisionTargetCount          BigInt    @map("revision_target_count")
  revisionTargetManifestDigest String    @map("revision_target_manifest_digest") @db.Char(64)
  ingressCutoff                BigInt    @map("ingress_cutoff")
  materializationCutoff        BigInt    @map("materialization_cutoff")
  state                        String
  attemptCount                 Int       @default(0) @map("attempt_count")
  leaseEpoch                   BigInt    @default(0) @map("lease_epoch")
  leaseTokenHash               String?   @map("lease_token_hash") @db.Char(64)
  workerId                     String?   @map("worker_id")
  leaseExpiresAt               DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  nextAttemptAt                DateTime  @map("next_attempt_at") @db.Timestamptz(6)
  createdAt                    DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime  @map("updated_at") @db.Timestamptz(6)

  @@id([siteRef, purgeJobRef])
  @@unique([siteRef, commandRef])
  @@index([state, nextAttemptAt, createdAt, purgeJobRef])
  @@map("memory_purge_job")
  @@schema("platform")
}

model MemoryPurgeRevisionTarget {
  siteRef            String    @map("site_ref")
  purgeJobRef        String    @map("purge_job_ref")
  targetOrdinal      BigInt    @map("target_ordinal")
  spaceRef           String    @map("space_ref")
  entryRef           String    @map("entry_ref")
  revision           BigInt
  revisionRef        String    @map("revision_ref")
  spaceGeneration    BigInt    @map("space_generation")
  learningGeneration BigInt    @map("learning_generation")
  revocationEpoch    BigInt    @map("revocation_epoch")
  targetedAt         DateTime  @map("targeted_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@id([siteRef, purgeJobRef, targetOrdinal])
  @@unique([siteRef, purgeJobRef, spaceRef, entryRef, revision, revisionRef])
  @@map("memory_purge_revision_target")
  @@schema("platform")
}

model MemoryPurgeParticipantReceipt {
  siteRef         String   @map("site_ref")
  purgeJobRef     String   @map("purge_job_ref")
  manifestVersion BigInt   @map("manifest_version")
  participantKey  String   @map("participant_key")
  status          String
  receiptRef      String   @map("receipt_ref")
  receiptDigest   String   @map("receipt_digest") @db.Char(64)
  recordedAt      DateTime @map("recorded_at") @db.Timestamptz(6)

  @@id([siteRef, purgeJobRef, participantKey])
  @@unique([siteRef, receiptRef])
  @@map("memory_purge_participant_receipt")
  @@schema("platform")
}

model MemorySuppressionTombstone {
  siteRef                String   @map("site_ref")
  suppressionRef         String   @map("suppression_ref")
  spaceRef               String   @map("space_ref")
  category               String
  spaceGeneration        BigInt   @map("space_generation")
  learningGeneration     BigInt   @map("learning_generation")
  privateKeyEpoch        BigInt   @map("private_key_epoch")
  suppressionFingerprint Bytes    @map("suppression_fingerprint")
  expiresAt              DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt              DateTime @map("created_at") @db.Timestamptz(6)

  @@id([siteRef, suppressionRef])
  @@unique([siteRef, spaceRef, category, spaceGeneration, learningGeneration, privateKeyEpoch, suppressionFingerprint])
  @@map("memory_suppression_tombstone")
  @@schema("platform")
}

model MemoryDatabaseRoleIdentity {
  roleKind String @id @map("role_kind")
  roleName String @unique @map("role_name")
  roleOid  Int    @unique @map("role_oid") @db.Oid

  @@map("memory_database_role_identity")
  @@schema("platform")
}

model MemoryTransitionAuthorityKey {
  keyRevision String   @id @map("key_revision")
  hmacKey     Bytes    @map("hmac_key")
  state       String
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)

  @@map("memory_transition_authority_key")
  @@schema("platform")
}

model CommandReceipt {
  commandId      String   @id @map("command_id")
  environment    String
  region         String
  callerIdentity String   @map("caller_identity")
  operation      String
  idempotencyKey String   @map("idempotency_key")
  requestDigest  String   @map("request_digest") @db.Char(64)
  state          String   @default("pending")
  result         Json?
  resultDigest   String?  @map("result_digest") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([environment, callerIdentity, operation, idempotencyKey])
  @@map("command_receipt")
  @@schema("platform")
}

model AdminOperatorAuthority {
  operatorRef           String   @map("operator_ref")
  operatorGeneration    BigInt   @map("operator_generation")
  state                 String
  permissions           String[]
  operatorSecurityEpoch BigInt   @map("operator_security_epoch")
  authorizationEpoch    BigInt   @map("authorization_epoch")
  expiresAt             DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([operatorRef, operatorGeneration])
  @@index([state, expiresAt])
  @@map("admin_operator_authority")
  @@schema("platform")
}

model AdminOperatorSiteScope {
  operatorRef        String   @map("operator_ref")
  operatorGeneration BigInt   @map("operator_generation")
  siteRef            String   @map("site_ref")
  environment        String
  region             String
  scopeEpoch         BigInt   @map("scope_epoch")
  state              String
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([operatorRef, operatorGeneration, siteRef, environment, region])
  @@index([siteRef, environment, region, state, expiresAt])
  @@map("admin_operator_site_scope")
  @@schema("platform")
}

model AdminOperatorGlobalScopeGrant {
  grantRef           String   @id @map("grant_ref") @db.Uuid
  operatorRef        String   @map("operator_ref")
  operatorGeneration BigInt   @map("operator_generation")
  environment        String
  region             String
  scopeEpoch         BigInt   @map("scope_epoch")
  state              String
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([operatorRef, operatorGeneration, environment, region, state, expiresAt])
  @@map("admin_operator_global_scope_grant")
  @@schema("platform")
}

model AdminBreakGlassGrant {
  grantRef            String   @id @map("grant_ref") @db.Uuid
  operatorRef         String   @map("operator_ref")
  operatorGeneration  BigInt   @map("operator_generation")
  incidentRef         String   @map("incident_ref")
  environment         String
  region              String
  authorizedOperation String   @map("authorized_operation")
  resourceRefs        String[] @map("resource_refs")
  fieldAllowlist      String[] @map("field_allowlist")
  scopeEpoch          BigInt   @map("scope_epoch")
  state               String
  approvedByRefs      String[] @map("approved_by_refs")
  expiresAt           DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([operatorRef, operatorGeneration, environment, region, state, expiresAt])
  @@map("admin_breakglass_grant")
  @@schema("platform")
}

model AdminOperatorIdentity {
  identityRef        String   @id @map("identity_ref") @db.Uuid
  issuer             String
  subject            String
  operatorRef        String   @map("operator_ref")
  operatorGeneration BigInt   @map("operator_generation")
  state              String
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([issuer, subject])
  @@index([operatorRef, operatorGeneration, state])
  @@map("admin_operator_identity")
  @@schema("platform")
}

model AdminOidcTransaction {
  transactionRef         String    @id @map("transaction_ref") @db.Uuid
  state                  String
  beginCommandId         String    @unique @map("begin_command_id")
  beginIdempotencyKey    String    @map("begin_idempotency_key")
  beginRequestDigest     String    @map("begin_request_digest") @db.Char(64)
  workloadIdentityRef    String    @map("workload_identity_ref")
  environment            String
  region                 String
  managedDeviceRef       String    @map("managed_device_ref")
  audience               String
  returnIntentRef        String    @map("return_intent_ref")
  issuer                 String
  clientId               String    @map("client_id")
  oidcAudience           String    @map("oidc_audience")
  exactCallbackUri       String    @map("exact_callback_uri")
  pkceVerifierCiphertext String    @map("pkce_verifier_ciphertext")
  pkceChallenge          String    @map("pkce_challenge")
  nonceCiphertext        String    @map("nonce_ciphertext")
  stateDigest            String    @map("state_digest") @db.Char(64)
  recoveryDigest         String    @unique @map("recovery_digest") @db.Char(64)
  signingKeyRevision     String    @map("signing_key_revision")
  deliveryKeyRevision    String    @map("delivery_key_revision")
  exchangeCommandId      String?   @unique @map("exchange_command_id")
  exchangeIdempotencyKey String?   @map("exchange_idempotency_key")
  exchangeRequestDigest  String?   @map("exchange_request_digest") @db.Char(64)
  operatorSessionRef     String?   @unique @map("operator_session_ref") @db.Uuid
  sessionExpiresAt       DateTime? @map("session_expires_at") @db.Timestamptz(6)
  deliveryEnvelope       String?   @map("delivery_envelope")
  exchangeReceipt        Json?     @map("exchange_receipt")
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(6)
  recoveryExpiresAt      DateTime  @map("recovery_expires_at") @db.Timestamptz(6)
  deliveryExpiresAt      DateTime? @map("delivery_expires_at") @db.Timestamptz(6)
  claimedAt              DateTime? @map("claimed_at") @db.Timestamptz(6)
  committedAt            DateTime? @map("committed_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([workloadIdentityRef, environment, region, beginIdempotencyKey])
  @@index([state, expiresAt])
  @@map("admin_oidc_transaction")
  @@schema("platform")
}

model AdminOperatorSession {
  operatorSessionRef    String    @id @map("operator_session_ref") @db.Uuid
  credentialDigest      String    @unique @map("credential_digest") @db.Char(64)
  operatorRef           String    @map("operator_ref")
  operatorGeneration    BigInt    @map("operator_generation")
  workloadIdentityRef   String    @map("workload_identity_ref")
  environment           String
  region                String
