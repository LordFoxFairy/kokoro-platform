  @@id([siteId, product, policyRevision, routeRole, position])
  @@unique([siteId, product, policyRevision, routeRole, modelKey])
  @@map("model_site_assignment_revision")
  @@schema("platform")
}

model ModelSitePolicyPointer {
  siteId       String   @map("site_id")
  product      String
  revision     BigInt
  policyDigest String   @map("policy_digest") @db.Char(64)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([siteId, product])
  @@map("model_site_policy_pointer")
  @@schema("platform")
}

model ModelSelectionDecision {
  decisionId           String   @id @map("decision_id") @db.Uuid
  decisionDigest       String   @map("decision_digest") @db.Char(64)
  siteId               String   @map("site_id")
  product              String
  routeRole            String   @map("route_role")
  requestDigest        String   @map("request_digest") @db.Char(64)
  requiredCapabilities Json     @map("required_capabilities")
  inventoryDigest      String   @map("inventory_digest") @db.Char(64)
  policyRevision       BigInt   @map("policy_revision")
  selectedModelKey     String?  @map("selected_model_key")
  selectedBindingKey   String?  @map("selected_binding_key")
  selectedRoute        Json?    @map("selected_route")
  candidateBindingKeys Json     @map("candidate_binding_keys")
  rejections           Json
  reason               String
  decidedAt            DateTime @map("decided_at") @db.Timestamptz(6)

  @@index([siteId, decidedAt(sort: Desc)])
  @@map("model_selection_decision")
  @@schema("platform")
}

model ModelOptionMaterialization {
  materializationId  String   @id @map("materialization_id") @db.Uuid
  artifactDigest     String   @map("artifact_digest") @db.Char(64)
  inventoryImportId  String   @map("inventory_import_id") @db.Uuid
  inventoryDigest    String   @map("inventory_digest") @db.Char(64)
  materializationDigest String @unique @map("materialization_digest") @db.Char(64)
  compilerVersion    String   @map("compiler_version")
  optionRevisionCount Int     @map("option_revision_count")
  quarantineCount    Int      @map("quarantine_count")
  materializedBy     String   @map("materialized_by")
  materializedAt     DateTime @default(now()) @map("materialized_at") @db.Timestamptz(6)

  @@unique([materializationId, artifactDigest, inventoryDigest, materializationDigest])
  @@map("model_option_materialization")
  @@schema("platform")
}

model ModelOptionRevision {
  revisionRef       String   @id @map("revision_ref")
  revisionDigest    String   @unique @map("revision_digest") @db.Char(64)
  inventoryImportId String  @map("inventory_import_id") @db.Uuid
  inventoryDigest  String   @map("inventory_digest") @db.Char(64)
  schemaVersion    Int      @map("schema_version")
  optionKey        String   @map("option_key")
  surface          String
  label            String
  description      String?
  tier             String?
  lifecycle        String
  inputModalities  String[] @map("input_modalities")
  outputModalities String[] @map("output_modalities")
  supportedEfforts String[] @map("supported_efforts")
  badges           String[]
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([inventoryDigest, surface, optionKey])
  @@map("model_option_revision")
  @@schema("platform")
}

model ModelOptionMaterializedRevision {
