  correlationId      String   @map("correlation_id")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([siteRef, aggregateSequence])
  @@index([createdAt, streamSequence])
  @@map("authorization_scoped_event_log")
  @@schema("platform")
}

