# LiteLLM runtime
# Local development can use the floating stable tag. Production should override
# this with an explicitly pinned tag or digest.
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
LITELLM_SCHEME=https
LITELLM_HOST=localhost
LITELLM_PORT=4000
LITELLM_BASE_URL=https://localhost:4000/v1
LITELLM_HEALTH_PATH=/health/liveliness
LITELLM_HEALTH_URL=
LITELLM_TLS_DIR=./secrets
LITELLM_CA_CERT_FILE=./secrets/ca.crt
LITELLM_MASTER_KEY=change-me-litellm-master-key

# OpenAI provider
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic provider
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# OpenAI-compatible upstream
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
